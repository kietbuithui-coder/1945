{
  "name": "vietnam-1945-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cửa Hàng 1945 — historical shop management & narrative simulation",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "assets:check": "tsx tools/check-assets.ts",
    "assets": "npm run assets:check",
    "sim": "tsx tools/sim.ts",
    "test": "npm run typecheck && npm run assets:check && npm run sim && npm run dom-test",
    "dom-test": "tsx tools/dom-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.5",
    "@fontsource/eb-garamond": "^5.2.5",
    "jsdom": "^31.0.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.0.0"
  }
}
